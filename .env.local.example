# Copy this file to .env.local and fill in your own keys.
# .env.local is git-ignored — never commit real keys.

# REQUIRED. Get one free at https://www.themoviedb.org/settings/api
# Either the "API Key" (32 characters) or the "API Read Access Token" (starts with eyJ) works.
TMDB_API_KEY=

# OPTIONAL. Adds IMDb / Rotten Tomatoes / Metascore to the movie modal.
# Free key: https://www.omdbapi.com/apikey.aspx  (1,000 requests/day)
OMDB_API_KEY=

# OPTIONAL. Which awards data source to use. "sample" is the built-in demo dataset.
AWARDS_PROVIDER=sample

# OPTIONAL. Point the app at a different TMDB-compatible server (used by `npm run mock`).
# TMDB_BASE_URL=http://localhost:4010/3
